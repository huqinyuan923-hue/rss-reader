# Neon Postgres 连接串（库名 feeds；Vercel Dashboard → Storage 或手动复制）
DATABASE_URL="postgresql://user:password@ep-xxx.neon.tech/feeds?sslmode=require"

# 登录密码（openssl rand -base64 12 生成一个强密码）
ADMIN_PASSWORD="change-me"

# 会话签名密钥（openssl rand -hex 32）
SESSION_SECRET="change-me-to-random-64-char-hex"

# Vercel Cron 调用密钥（openssl rand -hex 24；同时配置到 Vercel 环境变量）
CRON_SECRET="change-me-too"
